{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Unified App Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/app-server.mjs",
      "args": ["--dev"],
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": {
        "NODE_OPTIONS": "--enable-source-maps",
        "PORT": "3123",
        "APP_HOST": "127.0.0.1"
      }
    }
  ]
}