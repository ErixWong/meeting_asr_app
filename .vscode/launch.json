{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ASR Gateway",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/asr-gateway.mjs",
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": {
        "NODE_OPTIONS": "--enable-source-maps"
      }
    },
    {
      "name": "Attach ASR Gateway",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Next.js Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev",
      "cwd": "${workspaceFolder}"
    }
  ]
}